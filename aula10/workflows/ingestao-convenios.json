    {
      "parameters": {
        "jsCode": "const saida = []; \nfor (const item of $input.all()) { \n  for (const chave of Object.keys(item.binary ?? {})) { \n    const arquivo = item.binary[chave]; \n    saida.push({ json: { arquivo: arquivo.fileName }, binary: { data: arquivo } }); \n  }\n}\nreturn saida;"
