    {
      "parameters": {
        "code": {
          "supplyData": {
            "code": "const self = this;\nconst URL = 'http://embedding_api:8003/v1/embeddings';\nconst LOTE = 32;\n\nasync function chamar(textos, tipo) {\n  const r = await self.helpers.httpRequest({\n    method: 'POST',\n    url: URL,\n    headers: { 'Content-Type': 'application/json' },\n    body: { input: textos, input_type: tipo },\n    json: true,\n  });\n  return r.data.sort((a, b) => a.index - b.index).map((d) => d.embedding);\n}\n\nreturn {\n  embedDocuments: async (textos) => {\n    const out = [];\n    for (let i = 0; i < textos.length; i += LOTE) {\n      out.push(...(await chamar(textos.slice(i, i + LOTE), 'passage')));\n    }\n    return out;\n  },\n  embedQuery: async (texto) => (await chamar([texto], 'query'))[0],\n};"
          }
        },
        "inputs": {
          "input": []
        },
        "outputs": {
          "output": [
