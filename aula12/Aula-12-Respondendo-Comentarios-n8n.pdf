<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?><x:xmpmeta xmlns:x="adobe:ns:meta/" x:xmptk="xmp-writer"><rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"><rdf:Description rdf:about="" xmlns:dc="http://purl.org/dc/elements/1.1/"  xmlns:xmp="http://ns.adobe.com/xap/1.0/"  xmlns:xmpMM="http://ns.adobe.com/xap/1.0/mm/"  xmlns:xmpTPg="http://ns.adobe.com/xap/1.0/t/pg/"  xmlns:pdf="http://ns.adobe.com/pdf/1.3/" ><dc:title><rdf:Alt><rdf:li xml:lang="x-default">Respondendo comentÃ¡rios e mensagens com n8n</rdf:li></rdf:Alt></dc:title><dc:description><rdf:Alt><rdf:li xml:lang="x-default">O volume em que a conta do Instagram passa a escutar. Explica a verificaÃ§Ã£o e os eventos do webhook da Meta; expÃµe o n8n local por um tÃºnel com domÃ­nio fixo; constrÃ³i, nÃ³ a nÃ³, o fluxo que responde ao desafio, o que separa comentÃ¡rios e mensagens, a resposta por palavras-chave a um post escolhido e o agente com memÃ³ria que responde ao Direct; e discute o que o fluxo expÃµe, a transparÃªncia de ser um programa e o que nÃ£o se automatiza.</rdf:li></rdf:Alt></dc:description><pdf:Keywords>AutomaÃ§Ã£o de processos, Redes sociais, Instagram, Webhooks, Agentes conversacionais, n8n</pdf:Keywords><dc:creator><rdf:Seq><rdf:li>Benevid Felix da Silva</rdf:li></rdf:Seq></dc:creator><xmp:CreatorTool>Typst 0.15.1</xmp:CreatorTool><dc:language><rdf:Bag><rdf:li>pt-BR</rdf:li></rdf:Bag></dc:language><xmp:ModifyDate>2026-11-03T16:06:01-04:00</xmp:ModifyDate><xmp:CreateDate>2026-11-03T16:06:01-04:00</xmp:CreateDate><xmpTPg:NPages>48</xmpTPg:NPages><dc:format>application/pdf</dc:format><xmpMM:InstanceID>5t3j8rb/AiGcSm02XJF7GA==</xmpMM:InstanceID><xmpMM:DocumentID>19GvYDdETpLsH17Jp2/5Pg==</xmpMM:DocumentID><xmpMM:RenditionClass>proof</xmpMM:RenditionClass><pdf:PDFVersion>1.7</pdf:PDFVersion></rdf:Description></rdf:RDF></x:xmpmeta><?xpacket end="r"?>
