{
  "name": "Aula 12 - Verificação do webhook",
  "nodes": [
    {
      "id": "n1",
      "name": "Desafio da Meta",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        0
      ],
      "webhookId": "aula12-instagram-get",
      "parameters": {
        "httpMethod": "GET",
        "path": "instagram",
        "authentication": "none",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "n2",
      "name": "Token confere?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.query['hub.mode'] }}",
              "rightValue": "subscribe",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "c2",
              "leftValue": "={{ $json.query['hub.verify_token'] }}",
              "rightValue": "<TOKEN_DE_VERIFICACAO>",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "n3",
      "name": "Devolver o desafio",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        480,
        -100
      ],
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ $json.query['hub.challenge'] }}",
        "options": {}
      }
    },
    {
      "id": "n4",
      "name": "Recusar",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        480,
        100
      ],
      "parameters": {
        "respondWith": "text",
        "responseBody": "Token de verificação inválido",
        "options": {
          "responseCode": 403
        }
      }
    }
  ],
  "connections": {
    "Desafio da Meta": {
      "main": [
        [
          {
            "node": "Token confere?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Token confere?": {
      "main": [
        [
          {
            "node": "Devolver o desafio",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Recusar",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
