{
  "name": "Aula 12 - Comentários e Direct",
  "nodes": [
    {
      "id": "e1",
      "name": "Evento do Instagram",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        0
      ],
      "webhookId": "aula12-instagram-post",
      "parameters": {
        "httpMethod": "POST",
        "path": "instagram",
        "authentication": "none",
        "responseMode": "onReceived",
        "options": {}
      }
    },
    {
      "id": "e2",
      "name": "Separar eventos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "notes": "Why Code: achata entry[].changes[] e entry[].messaging[] em itens, filtrando ecos e eventos sem texto; nenhum nó nativo faz isso.",
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// A Meta envia um POST com object, entry[] e, dentro de cada entry,\n// changes[] (comentários) ou messaging[] (mensagens do Direct).\n// Este nó devolve um item por evento, com o campo \"tipo\" para o Switch.\nconst saida = [];\nfor (const item of $input.all()) {\n  const corpo = item.json.body ?? {};\n  for (const entrada of corpo.entry ?? []) {\n    for (const mudanca of entrada.changes ?? []) {\n      if (mudanca.field !== 'comments') continue;\n      const v = mudanca.value ?? {};\n      saida.push({ json: {\n        tipo: 'comentario',\n        comentario_id: v.id,\n        texto: v.text ?? '',\n        de_id: v.from?.id,\n        de_usuario: v.from?.username,\n        midia_id: v.media?.id,\n        midia_tipo: v.media?.media_product_type,\n        pai_id: v.parent_id ?? null,\n      }});\n    }\n    for (const m of entrada.messaging ?? []) {\n      if (!m.message || !m.message.text || m.message.is_echo) continue;\n      saida.push({ json: {\n        tipo: 'mensagem',\n        remetente: m.sender?.id,\n        destinatario: m.recipient?.id,\n        texto: m.message.text,\n        mensagem_id: m.message.mid,\n      }});\n    }\n  }\n}\nreturn saida;"
      }
    },
    {
      "id": "e3",
      "name": "Tipo de evento",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "mode": "rules",
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "r1",
                    "leftValue": "={{ $json.tipo }}",
                    "rightValue": "comentario",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "comentario"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "r2",
                    "leftValue": "={{ $json.tipo }}",
                    "rightValue": "mensagem",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "mensagem"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "e4",
      "name": "Do post e de outra pessoa",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [
        720,
