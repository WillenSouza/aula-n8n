            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "f1",
              "leftValue": "={{ $json.midia_id }}",
              "rightValue": "18154889593465679",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "f2",
              "leftValue": "={{ $json.de_id }}",
              "rightValue": "17841414956518013",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "e5",
      "name": "Palavra-chave",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        -100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Tabela de palavras-chave do post. A primeira regra que casar define a resposta.\n// Toda resposta termina identificando que foi automática.\nconst regras = [\n  { palavras: ['material', 'materiais', 'apostila', 'arquivo'],\n    resposta: 'O material está em github.com/benevid/material-de-apoio, uma pasta por volume.' },\n  { palavras: ['livro', 'ebook', 'volume', 'amazon'],\n    resposta: 'Os volumes da série IA Generativa e Agentes Autônomos estão na Amazon, como ebook.' },\n  { palavras: ['n8n', 'workflow', 'automação', 'automacao'],\n    resposta: 'Este post foi publicado por um workflow do n8n, que é o tema dos Volumes 9 a 12.' },\n  { palavras: ['parabéns', 'parabens', 'obrigado', 'obrigada', 'valeu', 'top'],\n    resposta: 'Obrigado! 🙌' },\n];\nconst normalizar = (t) => t.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');\nconst saida = [];\nfor (const item of $input.all()) {\n  const texto = normalizar(item.json.texto ?? '');\n  const regra = regras.find(r => r.palavras.some(p => texto.includes(normalizar(p))));\n  if (!regra) continue;                       // sem palavra-chave: não responde\n  saida.push({ json: { ...item.json, palavra: regra.palavras[0],\n    resposta: `${regra.resposta} (resposta automática)` } });\n}\nreturn saida;"
      },
      "notes": "Why Code: tabela de palavras-chave com normalização de acentos e primeira regra que casa; uma cadeia de IF/Switch ficaria longa e difícil de editar."
    },
