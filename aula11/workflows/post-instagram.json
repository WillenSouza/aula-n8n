      "parameters": {
        "formTitle": "Publicar no Instagram",
        "formDescription": "Escolha uma imagem JPEG do computador e escreva a legenda. O post sai na conta conectada ao app.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Imagem",
              "fieldType": "file",
              "multipleFiles": false,
              "acceptFileTypes": ".jpg,.jpeg",
              "requiredField": true
            },
            {
              "fieldLabel": "Legenda",
              "fieldType": "textarea",
              "requiredField": true
            }
          ]
        },
        "options": {
          "path": "post-instagram"
        }
      },
      "name": "Novo post",
