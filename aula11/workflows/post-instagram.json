        0
      ],
      "webhookId": "post-instagram",
      "id": "9055cae3-e1ad-478a-bf78-4b71c4dd5a20"
    },
    {
      "parameters": {
        "jsCode": "\nconst item = $input.first();\n\nconst chave = Object.keys(item.binary ?? {})[0];\n\nif (!chave) {\n  throw new Error('Nenhum arquivo recebido do formulário.');\n}\n\nconst arquivo = item.binary[chave];\n\nif (arquivo.mimeType !== 'image/jpeg') {\n  throw new Error(\n    `O Instagram aceita apenas JPEG; o arquivo recebido é ${arquivo.mimeType}.`\n  );\n}\n\nconst legenda = item.json.legenda ?? item.json.Legenda ?? '';\n\nreturn [\n  {\n    json: {\n      arquivo: arquivo.fileName,\n      legenda,\n    },\n    binary: {\n      imagem: arquivo,\n    },\n  },\n];\n"
      },
